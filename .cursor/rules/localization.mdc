---
description: 
globs: 
alwaysApply: true
---
# PackPal Localization Rules

# Rule to detect hardcoded strings in Dart files and provide suggestions to localize them
[detect_hardcoded_strings]
pattern = '\s(Text|title|label|hint|content):\s*(?:const\s+)?Text\([\'"](mdc:[^\'"]+)[\'"]\)'
message = "Detected hardcoded string. Consider using localization: {{match}} -> replace with LocaleKeys.{{path_snake_case}}.tr()"
files = ["**/*.dart"]
exclude = ["**/generated/**", "**/lib/generated/**", "**/test/**"]

# Rule to remind to run generation command after modifying translation files
[remind_generate_localization]
pattern = "^.*$"
message = "Remember to run 'flutter pub run easy_localization:generate --source-dir ./assets/translations -f keys -o locale_keys.g.dart' after modifying translation files"
files = ["**/assets/translations/*.json"]

# Rule to detect missing tr() calls in Text widgets
[detect_missing_tr]
pattern = 'LocaleKeys\.[a-zA-Z0-9_]+(?!\.tr\(\))'
message = "Missing tr() call for localization key: {{match}}"
files = ["**/*.dart"]
exclude = ["**/generated/**", "**/lib/generated/**", "**/test/**"]

# Rule to check for missing imports of locale_keys.g.dart in files using LocaleKeys
[check_missing_locale_import]
pattern = 'LocaleKeys\.'
requires_import = "import 'package:packpal/generated/locale_keys.g.dart';"
message = "Using LocaleKeys without importing locale_keys.g.dart"
files = ["**/*.dart"]
exclude = ["**/generated/**", "**/lib/generated/**", "**/test/**"]

# Localization workflow commands
[localization_commands]
add_key = "Add the key '{{key}}' to both English and Turkish translation files"
generate = "flutter pub run easy_localization:generate --source-dir ./assets/translations -f keys -o locale_keys.g.dart"
localize_file = "Scan this file for hardcoded strings and replace them with localization keys"

# Guide for creating new localization keys
[localization_guide]
structure = """
When adding new strings to the app:
1. Add keys to both assets/translations/en.json and assets/translations/tr.json
2. Use a consistent naming pattern (e.g., feature_section_element)
3. Run the generation command
4. Use LocaleKeys.key_name.tr() in your code
"""

# Quick snippets for localization
[localization_snippets]
import_statement = "import 'package:packpal/generated/locale_keys.g.dart';"
basic_text = "Text(LocaleKeys.key_name.tr())"
text_with_args = "Text(LocaleKeys.key_name.tr(args: ['arg1', 'arg2']))"
text_with_named_args = "Text(LocaleKeys.key_name.tr(namedArgs: {'arg1': 'value1', 'arg2': 'value2'}))" 